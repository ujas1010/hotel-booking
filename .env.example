# ====================================================================
# The Grand Imperial Palace & Luxury Suites - Environment Variables
# ====================================================================
# Copy this file to .env and replace placeholder values with your own.
# DO NOT commit your real .env file with sensitive passwords or API keys!
# ====================================================================

# --------------------------------------------------------------------
# 1. Application & Security Configuration
# --------------------------------------------------------------------
APP_URL="http://localhost:3000"
NODE_ENV="development"
PORT=3000

# Cryptographic HMAC-SHA256 Secret Key used to sign session tokens
SESSION_SECRET="your_long_random_session_secret_key_here"

# Palace Console Administrator Credentials
ADMIN_EMAIL="admin@grandimperialpalace.in"
ADMIN_PASSWORD="YourSecureAdminPasswordHere"
ADMIN_MASTER_KEY="YourSecureAdminMasterKeyHere"

# --------------------------------------------------------------------
# 2. Email Service Configuration (Nodemailer / Gmail App Password)
# --------------------------------------------------------------------
# Option A: Gmail SMTP with 16-character App Password (recommended)
# Generate via: Google Account -> Security -> 2-Step Verification -> App Passwords
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# Option B: Custom SMTP Server (Alternative)
SMTP_HOST="smtp.your-domain.com"
SMTP_PORT=587
SMTP_USER="smtp-username"
SMTP_PASS="smtp-password"

# --------------------------------------------------------------------
# 3. PostgreSQL Database Configuration (Cloud SQL or Local Postgres)
# --------------------------------------------------------------------
SQL_HOST="localhost"
SQL_USER="postgres"
SQL_PASSWORD="your_postgres_password"
SQL_DB_NAME="hotel_db"
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="your_postgres_password"

# --------------------------------------------------------------------
# 4. Supabase Authentication & Storage (Optional)
# --------------------------------------------------------------------
# From: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
